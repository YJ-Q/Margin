{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Closed JSON Schema for the Margin Agent Integration Report (margin-agent.report.json), the evidence artifact emitted alongside the manifest by skills/margin-agent-integration/SKILL.md. The report is for human review and is NOT input to Margin's runtime or margin agent verify. Per-claim status vocabulary: observed | weak | unverified | refused. $comment-prefixed keys are reserved at every level and always ignored.",
  "title": "Margin Agent Integration Report",
  "description": "Per-claim evidence for a Margin Agent manifest. Every claim records its stated observation and every refused capability records a reason. redaction{} records self-reported redaction work; schema validation cannot prove the absence of credentials or private content. Independent review and manifest verification remain required.",
  "type": "object",
  "required": ["reportVersion", "manifest", "agent", "claims", "requests", "unverified", "redaction"],
  "properties": {
    "reportVersion": { "const": 1 },
    "manifest": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false,
      "patternProperties": { "^\\$comment.*$": {} }
    },
    "agent": {
      "type": "object",
      "required": ["self", "environment"],
      "properties": {
        "self": {
          "type": "object",
          "required": ["type", "version", "executable"],
          "properties": {
            "type": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$" },
            "version": { "type": "string", "minLength": 1 },
            "executable": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false,
          "patternProperties": { "^\\$comment.*$": {} }
        },
        "environment": {
          "type": "object",
          "required": ["platform", "home", "detectedBy"],
          "properties": {
            "platform": { "type": "string", "minLength": 1 },
            "home": { "type": "string", "minLength": 1 },
            "detectedBy": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false,
          "patternProperties": { "^\\$comment.*$": {} }
        }
      },
      "additionalProperties": false,
      "patternProperties": { "^\\$comment.*$": {} }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "status"],
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "value": {},
          "status": { "enum": ["observed", "weak", "unverified", "refused"] },
          "evidence": {
            "type": "object",
            "required": ["detail"],
            "properties": {
              "command": { "type": "string" },
              "observedAt": { "type": "string", "minLength": 1 },
              "detail": { "type": "string", "minLength": 1 },
              "sampledValues": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false,
            "patternProperties": { "^\\$comment.*$": {} }
          }
        },
        "additionalProperties": false,
        "patternProperties": { "^\\$comment.*$": {} }
      }
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability", "provenance", "declarativeForm"],
        "properties": {
          "capability": { "type": "string", "minLength": 1 },
          "provenance": { "type": "string", "minLength": 1 },
          "publishableFields": { "type": "array", "items": { "type": "string" } },
          "stalenessRule": { "type": "string", "minLength": 1 },
          "declarativeForm": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false,
        "patternProperties": { "^\\$comment.*$": {} }
      }
    },
    "unverified": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction": {
      "type": "object",
      "required": ["scanned", "redacted"],
      "properties": {
        "scanned": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "redacted": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["what", "replacement"],
            "properties": {
              "what": { "type": "string", "minLength": 1 },
              "replacement": { "type": "string", "minLength": 1 },
              "occurrences": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false,
            "patternProperties": { "^\\$comment.*$": {} }
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": { "^\\$comment.*$": {} }
    }
  },
  "additionalProperties": false,
  "patternProperties": { "^\\$comment.*$": {} }
}

PORT=3000
NODE_ENV=development
MARGIN_SURFACE_HOST=127.0.0.1
MARGIN_SURFACE_PORT=3100
MARGIN_CORE_DB_PATH=./data/terminal-pilot/margin-core.sqlite
MARGIN_LOG_LEVEL=info

# Optional Pi runtime for the alternate Application Gateway. It remains usable without
# credentials, but model interactions return the stable runtime_unavailable code.
MARGIN_PI_PROVIDER=yapi
MARGIN_PI_MODEL=gpt-5.6-terra
MARGIN_PI_BASE_URL=https://yapi.click/v1
MARGIN_PI_API=openai-responses
MARGIN_PI_API_KEY_ENV=YAPI_API_KEY
YAPI_API_KEY=

# Historical deprecated API settings. `npm run legacy:api` reports archived
# status and never starts a server; these settings do not re-enable it.
MARGIN_LLM_PROVIDER=local
MARGIN_DB_PATH=./data/margin.sqlite

# Optional LLM providers.
# MARGIN_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
#
# MARGIN_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
#
# MARGIN_LLM_PROVIDER=siliconflow
# SILICONFLOW_API_KEY=
# SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3.2

# Optional TTS.
# SILICONFLOW_API_KEY=
